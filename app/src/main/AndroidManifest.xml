<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      There is deliberately no INTERNET permission. CopyEye reads screens; giving it a network
      channel at all would make "nothing is uploaded" a promise rather than a fact.
      There is also no CAMERA, RECORD_AUDIO or location permission, and none is needed.
    -->

    <!-- Draws the floating eye above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps the screen-capture session alive with a visible, stoppable notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      The service spends nearly all its life holding nothing but a floating window: no capture
      session, no screen access. Android still requires a foreground service to keep that window
      alive, and it must declare a type. `specialUse` is that idle type; the service switches to
      `mediaProjection` only for the moment a scan is actually running, and switches straight back.

      This is what lets CopyEye run all day without a screen-recording indicator on the status bar.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The ongoing notification is how the user stops CopyEye, so it is worth asking for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Short taps for scan start, text ready and copy complete. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Optional. Lets a user who has set Shizuku up capture without a consent dialog and without a
      screen-recording indicator. Absent Shizuku, this permission is simply never granted and the
      app uses the public screen-capture API instead.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".CopyEyeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CopyEye"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CopyEye"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The selection overlay.

          `excludeFromRecents` and `noHistory` keep it out of the user's task list: it is a
          momentary tool, and finding a stale screenshot of a banking app in Recents would be
          exactly the wrong outcome. `singleInstance` guarantees a second scan replaces the first
          rather than stacking.
        -->
        <activity
            android:name=".selection.ScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CopyEye.Scan"
            android:windowSoftInputMode="adjustResize" />

        <!--
          `configChanges` is what lets the service follow a rotation by resizing the existing
          virtual display; from Android 14 a second `createVirtualDisplay` call is not permitted.
        -->
        <service
            android:name=".overlay.FloatingEyeService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's floating scan button on screen. No screen access is
                    held in this state; the service switches to the mediaProjection type only while
                    a user-initiated scan is running." />
        </service>

        <!-- Shizuku discovers the app through this provider. It holds no data of its own. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
